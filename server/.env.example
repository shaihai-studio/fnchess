# ════════════════════════════════════════════════════════════════════
# 函数棋服务端 · 环境变量清单（空白蓝图）
#
# 这是一个**模板**：全部留空，按需填写即可，不含任何真实密钥或数据。
#
# 注意：server/index.js 直接读**系统环境变量**，不读取 .env 文件。
#   想用 .env 文件，任选一种方式：
#     1) Linux 临时：export $(grep -v '^#' .env | xargs) && npm start
#     2) systemd：单元文件里写 EnvironmentFile=/绝对路径/.env
#     3) 宝塔等面板：在 Node 项目的「环境变量」设置里逐条填写
#   （也可以直接 `npm i dotenv` 并在 index.js 顶部 require('dotenv').config()）
# ════════════════════════════════════════════════════════════════════

# ── 1. 监听地址 ─────────────────────────────────────────────────────
# 信令 /peerjs、大厅 /lobby、API /api 共用同一个端口
P2P_PORT=9000
# 监听网卡。对公网直接暴露用 0.0.0.0；只给本机 Nginx 反代用 127.0.0.1 更安全
P2P_HOST=0.0.0.0

# ── 2. CORS 白名单（前后端不同源时才需要） ──────────────────────────
# 填你自己的前端地址，多个用英文逗号分隔、不要带空格。
# 例：FNCHESS_ALLOWED_ORIGINS=https://your-game.example.com,http://192.168.1.10:8137
# 留空则只放行 localhost / 127.0.0.1 / file://（Origin 为 null）三种情况。
# 提示：若前端与后端同源（同一个域名，Nginx 同时托管静态站并反代 /api），这里可以不填。
FNCHESS_ALLOWED_ORIGINS=

# ── 3. TURN 中继（可选：只有对称型 NAT 环境才需要） ─────────────────
# 自建 coturn 的域名或 IP。留空 = 只下发公共 STUN（大多数家庭宽带够用）
FNCHESS_TURN_HOST=
# coturn 配置里的 static-auth-secret（限时凭证 HMAC 用）。
# 留空则 /api/ice 不下发 TURN 凭证。
# 也可以改用文件：把密钥写进 server/.turn-secret（已入 .gitignore，不会进仓库）
FNCHESS_TURN_SECRET=

# ── 4. 排行榜签名密钥（强烈建议设置） ───────────────────────────────
# 用于给排行榜上报做 HMAC 防伪，防止伪造成绩。
# 生成一条随机串：node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# 留空则首次启动自动生成 server/.lb-secret（已入 .gitignore）；
# 生产环境建议用环境变量注入，换机部署时不会因为丢了文件而让旧签名全部失效。
FNCHESS_LB_SECRET=
