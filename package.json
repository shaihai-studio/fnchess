{
  "name": "fnchess",
  "version": "2.0.0.2",
  "description": "【函数棋 fnchess】用函数打仗的数学策略游戏。",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build:web": "node scripts/build-web.js",
    "build:web:raw": "node scripts/build-web.js --no-bundle",
    "build:desktop": "node scripts/build.js",
    "sync": "npm run build:web && cap sync",
    "sync:ios": "npm run build:web && cap sync ios",
    "sync:android": "npm run build:web && cap sync android",
    "open:ios": "cap open ios",
    "open:android": "cap open android"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shaihai-studio/fnchess.git"
  },
  "keywords": [],
