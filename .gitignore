# 操作系统文件
Thumbs.db
Desktop.ini
.DS_Store

# IDE 文件
.idea/
.vscode/
*.swp
*.swo
.cursor/
.qoder/

# 项目缓存
node_modules/
.workbuddy/

# 构建产物与日志
www/
*.log

# ── 本地构建工具（JDK/Android SDK/Gradle，约 4GB，切勿入库） ────
tools/

# 原生构建产物
android/.gradle/
android/app/build/
android/build/
android/local.properties
ios/App/Pods/
ios/App/build/
ios/DerivedData/

# cap sync 生成的 Web 资源副本（CI 会自动生成）
android/app/src/main/assets/public/
ios/App/App/public/

# 本地调试产物（不入库）
vp-*.png
phone-*.png
smoke-splash.yaml
tmp_test_server_check.cjs
smoke-shots/
android-shots/

# ── 打包分发包（源码仓库不入库，避免仓库膨胀） ────────────────
*.zip

# 编辑器与工具缓存（不入库）
.codebuddy/
.playwright-cli/

# 签名文件（切勿入库）
*.keystore
*.jks
*.p12
*.mobileprovision

# ── 密钥/凭据与本地机密（切勿入库） ────────────────────────────
# .secrets/ 存放 SSH 口令、宝塔面板凭据、ACME 账户私钥、服务端私钥备份等
.secrets/
certs/
server/Nginx/privkey.key

# ── 一次性临时脚本归档（保留在本地便于追溯，不入库） ──────────
scripts/_archive/

# ── 自动化测试（不入库：脚本内含服务器地址与口令用法） ─────────
tests/
scripts/e2e-race-room.cjs
scripts/tmp-*

# ── 运维脚本（不入库：含服务器地址/账号/部署路径等运维信息） ───
scripts/deploy.py
scripts/ssh-connect.ps1
scripts/ssh-run.ps1
scripts/acme_issue.py
scripts/turn_check.py

# ── 服务端本地运行时数据（服务器上有独立副本，不入库） ────────
server/db/
server/*.bak
server/*.zip
server/leaderboard.json
server/notice.json
server/logs/
# TURN 共享密钥（coturn static-auth-secret / /api/ice 签发用）
server/.turn-secret
# 排行榜签名主密钥（server/index.js 首次启动自动生成，勿外传）
server/.lb-secret
# TLS 证书（私钥/证书链均为服务器产物）
server/Nginx/*.pem

# ── 环境变量文件（通常含密钥，切勿入库） ────────────────────────
# .env / .env.production 等一律忽略；.env.example 是空白模板，必须保留
.env
.env.*
!.env.example

# ── 本地备份文件（不入库） ─────────────────────────────────────
*.backup*

# 注：项目文档统一放在 docs/（版本说明、技术方案、重构规划、问题清单、素材许可等），
# 不再忽略。此前"按裸文件名忽略"的规则（问题清单/Goal/server.md/大重构计划/markdowns 等）
# 会匹配任意目录，曾在 2026-09-24 造成"文档移进 docs/ 后仍不入库"的隐患，已清理。

# ── Python / 编辑器缓存 ────────────────────────────────────────
__pycache__/
*.pyc
